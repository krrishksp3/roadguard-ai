# =================================================================
# ROADGUARD AI — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# =================================================================
# Copy relevant sections to backend/.env and frontend/.env respectively.
# NEVER commit real production secrets, passwords, or API keys.

# -----------------------------------------------------------------
# 1. BACKEND SERVICE CONFIGURATION
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=production

# -----------------------------------------------------------------
# 2. PRODUCTION DATABASE (PostgreSQL)
# -----------------------------------------------------------------
# For Production (Render / Supabase / Neon / AWS RDS / Docker):
DATABASE_URL="postgresql://user:password@host:5432/roadguard_ai?schema=public"

# For Local Offline Development (Fallback SQLite):
# DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------
JWT_SECRET="your-strong-random-production-jwt-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# -----------------------------------------------------------------
# 4. CORS & FRONTEND ORIGIN ALLOWLIST
# -----------------------------------------------------------------
# Comma-separated list of allowed production origins:
FRONTEND_URL="https://roadguard-frontend.onrender.com,https://roadguard-ai.vercel.app"

# -----------------------------------------------------------------
# 5. OBJECT STORAGE (Persistent Citizen Road Evidence Photos)
# -----------------------------------------------------------------
# Options: "local" | "cloudinary" | "supabase"
STORAGE_PROVIDER="cloudinary"

# A. Cloudinary Configuration (Recommended for hackathons / zero setup):
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="roadguard_preset"

# B. Supabase Storage Configuration (Alternative):
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# SUPABASE_STORAGE_BUCKET="roadguard-evidence"

# -----------------------------------------------------------------
# 6. AI INTELLIGENCE ENGINE (Optional - DemoAIProvider is built-in)
# -----------------------------------------------------------------
AI_PROVIDER="demo" # "demo" | "gemini" | "openai"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# -----------------------------------------------------------------
# 7. FRONTEND CLIENT CONFIGURATION (Vite)
# -----------------------------------------------------------------
# Set in frontend hosting platform (Render / Vercel / Netlify):
VITE_API_URL="https://roadguard-backend.onrender.com/api"
